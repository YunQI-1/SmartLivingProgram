<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jsu.old.mapper.StudentInformationMapper">

    <select id="getStudentInformationDetail" parameterType="com.jsu.dto.QueryDTO" resultType="com.jsu.vo.StudentInformationVO">
        Select * from student_information
        <where>
            <if test="studentNumber != null and studentNumber!=''">student_number = #{studentNumber}</if>
            <if test="studentName != null and studentName!=''">and student_name = #{studentName}</if>
            <if test="classes != null and classes!=''">and classes = #{classes}</if>
            <if test="grade != null and grade!=''">and grade = #{grade}</if>
            <if test="major != null and major!=''">and major = #{major}</if>
            <if test="college != null and college!=''">and college = #{college}</if>
        </where>
    </select>
</mapper>