<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jsu.mapper.PaperMapper">


    <update id="updateByDoi" parameterType="com.jsu.entity.Paper">
        UPDATE paper
        <set>
            <!-- 动态更新字段 -->
            <if test="studentNumber != null and studentNumber != ''">
                student_number = #{studentNumber},
            </if>
            <if test="studentName != null and studentName != ''">
                student_name = #{studentName},
            </if>
            <if test="paperName != null and paperName != ''">
                paper_name = #{paperName},
            </if>
            <if test="journalName != null and journalName != ''">
                journal_name = #{journalName},
            </if>
            <if test="yearOfPublication != null">
                year_of_publication = #{yearOfPublication},
            </if>
            <if test="volumeNumber != null">
                volume_number = #{volumeNumber},
            </if>
            <if test="issue != null">
                issue = #{issue},
            </if>
            <if test="articlePage != null and articlePage != ''">
                article_page = #{articlePage},
            </if>
            <if test="editorRanking != null and editorRanking != ''">
                editor_ranking = #{editorRanking},
            </if>
            <if test="instructor != null and instructor != ''">
                instructor = #{instructor},
            </if>
            <if test="photo != null and photo != ''">
                photo = #{photo},
            </if>
        </set>
        WHERE doi = #{doi}
    </update>
    <update id="createPaper">
        INSERT IGNORE INTO paper (
        student_number,
        student_name,
        paper_name,
        journal_name,
        year_of_publication,
        volume_number,
        issue,
        article_page,
        doi,
        editor_ranking,
        instructor,
               photo
        ) VALUES
        <foreach collection="paperList" item="item" separator=",">
            (
            #{item.studentNumber},
            #{item.studentName},
            #{item.paperName},
            #{item.journalName},
            #{item.yearOfPublication},
            #{item.volumeNumber},
            #{item.issue},
            #{item.articlePage},
            #{item.doi},
            #{item.editorRanking},
            #{item.instructor},
            #{item.photo}
            )
        </foreach>
    </update>
    <select id="getAllPaper" resultType="com.jsu.entity.Paper">
        SELECT * FROM paper
    </select>
</mapper>