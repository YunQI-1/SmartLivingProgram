<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jsu.mapper.EnglishLevelMapper">


    <update id="updateByCertificateNumber" parameterType="com.jsu.entity.EnglishLevel">
        UPDATE english_level
        <set>
            <!-- 动态更新字段 -->
            <if test="studentNumber != null and studentNumber != ''">
                student_number = #{studentNumber},
            </if>
            <if test="studentName != null and studentName != ''">
                student_name = #{studentName},
            </if>
            <if test="idCard != null and idCard != ''">
                id_card = #{idCard},
            </if>
            <if test="typeName != null and typeName != ''">
                type_name = #{typeName},
            </if>
            <if test="examinationCertificateNumber != null and examinationCertificateNumber != ''">
                examination_certificate_number = #{examinationCertificateNumber},
            </if>
            <if test="college != null and college != ''">
                college = #{college},
            </if>
            <if test="major != null and major != ''">
                major = #{major},
            </if>
            <if test="score != null">
                score = #{score},
            </if>
            <if test="issuingDepartment != null and issuingDepartment != ''">
                issuing_department = #{issuingDepartment},
            </if>
            <if test="getTime != null">
                get_time = #{getTime},
            </if>
            <if test="photo != null and photo != ''">
                photo = #{photo},
            </if>
        </set>
        WHERE certificate_number = #{certificateNumber}
    </update>
    <update id="createEnglishLevel">
        INSERT IGNORE INTO english_level (
        certificate_number,
        student_number,
        student_name,
        id_card,
        type_name,
        examination_certificate_number,
        college,
        major,
        score,
        issuing_department,
        get_time,
        photo
        ) VALUES
               <foreach collection="englishLevels" item="item" separator=",">
                    (
                    #{item.certificateNumber},
                    #{item.studentNumber},
                    #{item.studentName},
                    #{item.idCard},
                    #{item.typeName},
                    #{item.examinationCertificateNumber},
                    #{item.college},
                    #{item.major},
                    #{item.score},
                    #{item.issuingDepartment},
                    #{item.getTime},
                    #{item.photo},
                    )
                </foreach>
    </update>
    <select id="getAllEnglishLevel" resultType="com.jsu.entity.EnglishLevel">
        SELECT * FROM english_level
    </select>
</mapper>